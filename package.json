{
  "name": "emergence-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A classroom laboratory for exploring emergent spatial behaviour.",
  "homepage": "https://akkauppi.github.io/emergence/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akkauppi/emergence.git"
  },
  "bugs": {
    "url": "https://github.com/akkauppi/emergence/issues"
  },
  "keywords": [
    "agent-based-modeling",
    "emergence",
    "education",
    "generative-systems",
    "urban-morphology",
    "simulation"
  ],
  "scripts": {
    "bundle:life-solver": "node scripts/bundle-life-solver.mjs",
    "predev": "npm run bundle:life-solver",
    "dev": "node scripts/dev-server.mjs",
    "prebuild": "npm run bundle:life-solver",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "evaluate:territory": "node scripts/evaluate-territory.mjs",
    "diagnose:territory": "node scripts/diagnose-territory.mjs",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "logic-solver-plus": "0.2.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
